{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "description": "One rolling PR for every non-major update; majors get their own.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "dependencies"
    }
  ]
}
