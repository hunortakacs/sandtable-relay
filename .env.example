# Shared secret both the ESP and the webapp present as the second websocket
# subprotocol. Must match the firmware's CONFIG_WEBSOCKET_PASSWORD and the
# frontend's WEBSOCKET_PASSWORD.
WEBSOCKET_PASSWORD=changeme

# Only needed on hosts that idle the service out (Render's free tier). Leave
# unset on a VPS.
# KEEPALIVE_URL=https://example.com/ping
